# Server-only URL for the existing Google Apps Script Web App deployment.
GOOGLE_APPS_SCRIPT_URL=

# Shared with the Apps Script project's ADMIN_SECRET script property.
# For the prototype this also acts as the admin login password unless
# ADMIN_PASSWORD is explicitly set below.
GOOGLE_APPS_SCRIPT_ADMIN_SECRET=

# Optional stricter admin-login override.
# When ADMIN_EMAIL is blank, any non-empty email can be used with the
# configured password. Set both to pin login to a specific email/password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
