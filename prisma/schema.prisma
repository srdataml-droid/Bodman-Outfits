// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Single-row shop configuration, matching the ShopSettings interface
// documented in docs/api.md exactly. `id` is a fixed singleton row key
// (see SINGLETON_ID in shop-settings.service.ts), not part of the public
// API response shape.
model ShopSettings {
  id                String   @id @default(cuid())
  shopName          String
  tagline           String
  phone             String
  whatsappNumber    String
  email             String
  address           String
  cityCountry       String
  hoursWeekday      String
  hoursSaturday     String
  hoursSunday       String
  pricingNote       String
  depositPercentage Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Public FAQ content — a list, not a singleton, so `id` uses normal
// cuid() generation (no fixed singleton key). Matches the FaqEntry shape
// already established in apps/web/lib/faq-data.ts. `category` is nullable
// since grouping is optional per the original frontend type; `sortOrder`
// (not `order`, a reserved SQL keyword) controls display sequence within
// a category. Admin-editable per AGENTS.md, though no write endpoints
// exist yet — see docs/api.md.
model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Customer-requested fitting/consultation slots. Fields mirror exactly what
// apps/web/components/appointment-form.tsx collects — nothing invented on
// top of it. See docs/api.md "Appointment Requests" for the full contract.
enum AppointmentTime {
  morning
  afternoon
  evening
}

// Per AGENTS.md — Confirmed Product Policies: "Fitting-session booking is a
// customer request, not a live calendar. Admin confirms or proposes an
// alternative." `pending` is therefore the only valid initial state; the
// customer never sets this field.
enum AppointmentStatus {
  pending
  confirmed
  declined
}

model Appointment {
  id            String            @id @default(cuid())
  name          String
  /// Required since 2026-08-18, and phone made optional in the same change.
  /// This used to be the other way round, which made Appointment the only one
  /// of the three request types keyed on a phone number: Enquiry and
  /// CustomRequest both already required an email. The confirmation and
  /// reminder mail an appointment depends on had no guaranteed destination
  /// while this was nullable.
  email         String
  phone         String?
  // Date-only (@db.Date), not a timestamp: the customer picks a calendar
  // day, not an instant, so storing a time component would invent precision
  // they never gave and risk a timezone shifting the date by one day.
  preferredDate DateTime          @db.Date
  preferredTime AppointmentTime
  // Plain String rather than a database enum, unlike the two above: these
  // values mirror the catalogue categories in apps/web/lib/garments.ts,
  // which are editable business content expected to change. A Postgres enum
  // would need a migration every time the catalogue gains a category.
  // Validated against an explicit allowlist in appointments.schema.ts.
  category      String
  notes         String?
  status        AppointmentStatus @default(pending)
  // timestamptz, unlike the older tables in this schema which use plain
  // timestamp. Timezone-aware is the correct choice (see the Supabase
  // Postgres best-practices skill) and matters here because these rows will
  // be read directly in the Supabase dashboard, not only through Prisma.
  // The earlier tables should follow in their own migration — see
  // docs/database.md.
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  orders Order[]

  // Admin lists these newest-first; index supports that ordering.
  @@index([createdAt])
}

// Contact-page enquiries. A deliberately separate entity from Appointment,
// not a shared "submission" table: the two forms collect different required
// fields and mean different things (an appointment is a scheduling request
// with a confirm/decline workflow, an enquiry is a message awaiting a
// reply). Full comparison in docs/api.md.
//
// Only two states, because that is all the confirmed behaviour supports:
// an enquiry has either been replied to or it has not. No triage or
// archival workflow is invented here.
enum EnquiryStatus {
  unread
  replied
}

model Enquiry {
  id        String        @id @default(cuid())
  name      String
  // Required here, unlike on Appointment where phone is the required
  // channel. This mirrors the existing contact form exactly rather than
  // standardising the two forms against each other.
  email     String
  phone     String?
  // Plain String rather than a Postgres enum. The wire values come from the
  // existing form and include "custom-request", whose hyphen is not a legal
  // Postgres enum identifier. A native enum would therefore need @map plus a
  // translation layer in both directions, and the only thing gained over the
  // Zod allowlist that already guards this boundary would be a second copy
  // of the same constraint. Same call as Appointment.category, for a
  // different reason.
  subject   String
  message   String
  status    EnquiryStatus @default(unread)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  orders Order[]

  // Admin lists newest-first.
  @@index([createdAt])
}

// Customer-originated design requests: someone starts from their own idea
// rather than an existing catalogue piece. Spec'd in the atelier-frontend
// skill; see docs/api.md for where this implementation deviates from it and
// why.
enum CustomRequestStatus {
  pending_review
  accepted
  declined
}

model CustomRequest {
  id            String              @id @default(cuid())
  // Contact fields are NOT in the skill's field list, which names only
  // description, reference image and category. They are added because
  // customers have no accounts: without a name and a way to reply, an
  // accepted request cannot be acted on and a declined one cannot be
  // answered. Mirrors what Appointment and Enquiry already collect.
  name          String
  email         String
  phone         String?
  description   String
  /// What the piece is for - a wedding, a burial, the office. Shapes the cut
  /// and the cloth, and is the second thing any tailor asks.
  occasion      String?
  /// The first thing any tailor asks. Stored as a DATE rather than inside the
  /// description so the review queue can be sorted and filtered by it: a
  /// wedding in nine days is a different decision from one in nine weeks.
  neededBy      DateTime?           @db.Date
  // Optional link to a catalogue category, as a plain String for the same
  // reason as Appointment.category: these mirror editable catalogue content
  // and a database enum would need a migration every time it changes.
  category      String?
  status        CustomRequestStatus @default(pending_review)
  // Per the skill: declining requires a reason. Enforced in the service
  // rather than by the database, because "required only when status is
  // declined" is a conditional constraint the schema cannot express cleanly.
  declineReason String?
  // Which admin reviewed it. Nullable because it is unset until reviewed.
  reviewedById  String?
  reviewedBy    Admin?              @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?           @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)

  orders Order[]

  // The skill specifies an oldest-first review queue, so the index supports
  // ascending createdAt rather than the descending order used elsewhere.
  @@index([createdAt])
  @@index([reviewedById])
}

// Orders are admin-created only. There is no customer checkout, no payment
// integration and no public endpoint, because both depend on pricing
// decisions that have not been made. See docs/api.md.
enum OrderStatus {
  draft
  in_production
  ready
  completed
  cancelled
}

model Order {
  id              String         @id @default(cuid())
  // Exactly one source should be set. Modelled as three nullable foreign
  // keys rather than a polymorphic (type, id) pair so the database still
  // enforces that the referenced row exists; the "exactly one" rule is
  // enforced in the service, since a CHECK across three columns would have
  // to be hand-written outside Prisma's schema language.
  appointmentId   String?
  appointment     Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  enquiryId       String?
  enquiry         Enquiry?       @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  customRequestId String?
  customRequest   CustomRequest? @relation(fields: [customRequestId], references: [id], onDelete: SetNull)

  // Snapshot of who the order is for. Denormalised deliberately: the source
  // request can be deleted (all three relations are SetNull), and an order
  // that loses the customer's name because a request was tidied up would be
  // worse than a little duplication.
  customerName  String
  /// Nullable since 2026-08-17: a custom request may carry no phone, and the
  /// admin screen previously satisfied a NOT NULL by writing the email here.
  /// At least one of phone or email is required, enforced in the schema layer.
  customerPhone String?
  /// Snapshotted for the same reason as the name and phone above: the source
  /// request can be deleted and an order that loses the address cannot tell
  /// the customer their garment is ready. Nullable because `email` is
  /// optional on all three request models - most customers leave a number.
  customerEmail String?

  status OrderStatus @default(draft)
  notes  String?

  // Pricing is nullable throughout and stays that way. No pricing or deposit
  // policy has been confirmed, so there is nothing to default to and a zero
  // would read as "free" rather than "not yet decided". Decimal rather than
  // Float because money must not be stored in binary floating point.
  totalAmount   Decimal? @db.Decimal(12, 2)
  depositAmount Decimal? @db.Decimal(12, 2)
  currency      String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
  @@index([status])
}

// The only authenticated role in this platform (AGENTS.md — Confirmed
// Product Policies). Real email+password login, never a PIN or hard-coded
// bypass. passwordHash is a bcrypt hash — never store or return plaintext.
model Admin {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     AdminSession[]
  reviewed     CustomRequest[]
}

// Server-side session store backing the Admin login cookie. Only a SHA-256
// hash of the session token is persisted (tokenHash) — the raw token lives
// solely in the client's httpOnly cookie, so a database read alone can never
// reconstruct a valid session, matching how passwordHash is handled above.
model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId])
}

/// Catalogue garments, moved out of apps/web/lib/garments.ts so the business
/// can add pieces without a deploy.
///
/// CATEGORIES DELIBERATELY STAY IN CODE. The five lines (suits, agbada,
/// kaftan, casuals, corporate) carry confirmed prices, the item-vs-outfit
/// price unit, and per-line copy the owner signed off. `category` here is a
/// plain string validated against that list in the API, not a foreign key —
/// moving categories to the database is a separate decision, not a side
/// effect of making garments editable.
///
/// `startingPrice` is NULLABLE and means "inherit this line's price". The
/// five confirmed prices are per CATEGORY, not per garment; a non-null value
/// here is an override the owner has explicitly typed, never a copy of the
/// category price that can silently drift from it.
model Garment {
  id            String   @id @default(cuid())
  slug          String
  /// One of the CategorySlug values in apps/web/lib/garments.ts.
  category      String
  name          String
  /// Short label under the name on a card, e.g. "Suits".
  detail        String
  description   String
  /// Paths under apps/web/public, e.g. /images/catalogue/navy-two-piece-flat.png
  imageFlat     String
  imageOnForm   String
  altFlat       String
  altOnForm     String
  /// Naira. Null inherits the category's confirmed starting price.
  startingPrice Int?
  /// Deactivating hides a garment from the public catalogue without deleting
  /// it, so a piece can be withdrawn and brought back without losing its copy.
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  // timestamptz, matching Appointment/Enquiry/CustomRequest/Order rather than
  // the older plain-timestamp tables. See the note on Appointment.createdAt.
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@unique([category, slug])
  @@index([category, active])
}
